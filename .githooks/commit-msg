#!/bin/sh
# commit-msg: enforce Conventional Commits on the subject line.
#
# Allowed:
#   feat: xxx            feat(scope): xxx        fix!: xxx
#   fix(build): xxx      chore(release): 0.10.0
#
# Skipped: messages generated by git itself (Merge / Revert / fixup! / squash!).
# Rules live in docs/conventions.md.

msg_file="$1"

subject=$(awk '/^#/ {next} /^[[:space:]]*$/ {next} {print; exit}' "$msg_file")

case "$subject" in
  "" )
    echo "commit-msg: empty commit message." >&2
    exit 1
    ;;
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "* )
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._-]+\))?!?: .+'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject does not follow Conventional Commits." >&2
  echo "" >&2
  echo "  got: $subject" >&2
  echo "" >&2
  echo "  expected: <type>(<scope>): <summary>" >&2
  echo "  type     : feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  example  : feat(organization): add member list page" >&2
  echo "" >&2
  echo "  See docs/conventions.md." >&2
  exit 1
fi

exit 0
